{
	// This repo's oxlint config: the fleet's shared rules (.oxlintrc.json,
	// byte-identical everywhere, through extends), plus what extends does not
	// carry over: the plugins, the environment this repo's JavaScript runs in,
	// and the globals its pages get from the libraries their <script> tags
	// load, so no-undef knows them and still catches every other undefined name.
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"extends": ["./.oxlintrc.json"],
	"plugins": ["eslint"],
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"globals": {
		// Prototype (jssrc/toolkits/prototype.js), which every page loads first: classes
		"Class": "readonly",
		// jQuery (jssrc/toolkits/jquery.js), which every page loads after Prototype
		"jQuery": "readonly",
		// SyntaxHighlighter (jssrc/toolkits/sh), which the slide pages load: code highlighting
		"SyntaxHighlighter": "readonly"
	},
	// the pages load jssrc/src's files in order as plain <script>s: each file may use what an earlier one defines (the comment names it)
	"overrides": [
		{
			"files": ["jssrc/src/LayoutCenter.js"],
			"globals": {
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/LayoutFlow.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkMustHave": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/LayoutFull.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkExact": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/LayoutRatio.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkExact": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/LayoutRelative.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkCloseTo": "readonly",
				// jssrc/src/jqutils.js
				"checkHasOnly": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/LayoutResolver.js"],
			"globals": {
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/Mgr.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkHasOnly": "readonly",
				// jssrc/src/jqutils.js
				"checkMustHave": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutResolver.js
				"LayoutResolver": "readonly",
				// jssrc/src/Slide.js
				"Slide": "readonly",
				// jssrc/src/TransHideShow.js
				"TransHideShow": "readonly",
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		},
		{
			"files": ["jssrc/src/TemplateTitleBullets.js"],
			"globals": {
				// jssrc/src/jqutils.js
				"checkHasOnly": "readonly",
				// jssrc/src/Set.js
				"KeynoteSet": "readonly",
				// jssrc/src/LayoutFlow.js
				"LayoutFlow": "readonly",
				// jssrc/src/LayoutFull.js
				"LayoutFull": "readonly",
				// jssrc/src/LayoutRatio.js
				"LayoutRatio": "readonly",
				// jssrc/src/LayoutRelative.js
				"LayoutRelative": "readonly"
			}
		},
		{
			"files": ["jssrc/src/TransHideShow.js"],
			"globals": {
				// jssrc/src/Utils.js
				"Utils": "readonly"
			}
		}
	]
}
